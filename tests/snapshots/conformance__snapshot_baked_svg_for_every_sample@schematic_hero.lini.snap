    .lini { font-family: "Google Sans Code", ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, "Liberation Mono", monospace; font-size: 15px; font-weight: 500; color: black; }
    .lini .lini-canvas { fill: white; }
    .lini .lini-block { fill: none; stroke: none; stroke-width: 2; stroke-dasharray: none; }
    .lini .lini-path { fill: white; stroke: #444; stroke-width: 2; stroke-dasharray: none; }
    .lini .lini-line { fill: none; stroke: #444; stroke-width: 2; stroke-dasharray: none; }
    .lini .lini-text { fill: currentColor; stroke: none; text-anchor: middle; }
    .lini .lini-gutter { stroke: none; }
    .lini .lini-box { fill: white; stroke: #444; stroke-width: 2; }
    .lini .lini-group { fill: rgba(0, 0, 0, 0.03); stroke: rgba(0, 0, 0, 0.4); stroke-width: 1; stroke-dasharray: 4,3; }
    .lini .lini-caption { color: rgba(0, 0, 0, 0.5); font-size: 12px; font-weight: 400; }
    .lini .lini-table { fill: none; stroke: #444; stroke-width: 2; font-size: 14px; font-weight: normal; stroke-dasharray: none; }
    .lini .lini-page { fill: white; stroke-width: 0; }
    .lini .lini-title-block { stroke-width: 1; font-size: 11px; }
    .lini .lini-field { color: rgba(0, 0, 0, 0.5); font-size: 10px; }
    .lini .lini-frame { fill: none; stroke: #444; stroke-width: 2; }
    .lini .lini-zone { color: rgba(0, 0, 0, 0.545); font-size: 9px; }
    .lini .lini-tick { fill: none; stroke: #444; stroke-width: 1; }
    .lini .lini-component { fill: #fdf6d8; stroke: #8a1c1c; stroke-width: 1.5; }
    .lini .lini-pin { font-size: 11px; }
    .lini .lini-label { color: #0e6a6a; font-size: 11px; }
    .lini .lini-sch-line { fill: none; stroke: #8a1c1c; stroke-width: 1.5; }
    .lini .lini-sch-solid { fill: #8a1c1c; stroke: none; }
    .lini .lini-sch-tag-line { fill: none; stroke: #0e6a6a; stroke-width: 1.5; }
    .lini .lini-pin-stub { fill: none; stroke: #8a1c1c; stroke-width: 1.5; }
    .lini .lini-pin-number { color: #00000073; font-size: 9px; }
    .lini .lini-ref { font-size: 11px; font-weight: 600; }
    .lini .lini-part-value { font-size: 11px; }
    .lini .lini-link { fill: none; stroke: #444; stroke-width: 2; stroke-dasharray: none; }
    .lini .lini-links .lini-schematic-wire { stroke: #0a7a2f; stroke-width: 1.5; }
