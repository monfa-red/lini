// Series kinds and per-datum paint [SPEC 14.2, 14.6] — the half of the chart
// family the hero board doesn't carry: `bars: stacked` laid on its side by
// `direction: row` and `bars: overlay` stacked front-to-back, `curve: step`
// against a plain `linear` line with marker-only |dots| scattered over both,
// an |area| floated on an explicit `baseline:` instead of zero, `fill:` and
// `stroke:` comma lists pulling one bar and one point out of the walk,
// `tooltip:` forced on and held back to hover, radial |bars|, the donut's
// `hole:`.
{
  layout: grid; columns: repeat(2); gap: 24;
}

|chart| "Revenue by region ($k)" {
  width: 350; height: 240; direction: row; bars: stacked; categories: "Q1", "Q2", "Q3", "Q4";
} [
  |bars| "NA" { data: 40, 45, 50, 60; }
  |bars| "EU" { data: 30, 35, 33, 40; }
  |bars| "APAC" { data: 20, 25, 30, 38; }
]

// Overlay puts v2 in front of v1, so the time saved is the exposed collar; the
// per-datum `fill:` [SPEC 14.6] flags the stage that didn't get faster, and
// the deltas ride `labels:` under `tooltip: hover` — read on the point, not
// printed over the bars.
|chart| "Deploy time (s)" {
  width: 350; height: 240; bars: overlay; tooltip: hover; categories: "build", "test", "ship";
} [
  |bars| "v1" { data: 96, 154, 41; }
  |bars| "v2" {
    data: 63, 148, 38; fill: auto, --red, auto; labels: "-34%", "-4%", "-7%";
  }
]

// `tooltip: always` forces every account's overpay onto the plot rather than
// letting the crowded ones fall to hover — the export setting [SPEC 14.8].
|chart| "Plan price vs. usage ($)" { width: 350; height: 240; tooltip: always; } [
  |axis| "GB transferred" { side: bottom; range: 0 40; }
  |axis| "monthly bill" { side: left; }
  |line| "list price" { data: 0 5, 10 12, 25 30, 40 30; curve: step; }
  |line| "metered" { data: 0 0, 40 34; curve: linear; }
  |dots| "accounts" {
    data: 6 5, 13 12, 19 12, 29 30, 34 30; fill: auto, auto, auto, --red, auto; stroke: auto, auto, auto, --red-ink, auto; labels: "-$0", "+$1", "-$4", "+$5", "+$1";
  }
]

// `baseline: 40` floats the fill on the target instead of zero, so a wet month
// reads as area above the line and a dry one as area below it.
|chart| "Reservoir level (m)" {
  width: 350; height: 240; categories: "Apr", "May", "Jun", "Jul", "Aug", "Sep";
} [
  |axis#m| { side: left; range: 20 60; }
  |mark| "target" {
    at: 40; axis: m; stroke: --gray-deep; stroke-style: dashed;
  }
  |area| "level" { data: 52, 48, 41, 34, 29, 36; baseline: 40; }
]

|chart| "Goal completion (%)" {
  width: 350; height: 240; direction: radial; categories: "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun";
} [
  |axis| { range: 0 100; step: 50; }
  |bars| "steps" { data: 80, 65, 90, 70, 95, 40, 55; }
]

|pie| "Storage by class" { width: 350; height: 240; hole: 0.55; } [
  |slice| "Hot" { value: 38; }
  |slice| "Warm" { value: 27; }
  |slice| "Cold" { value: 22; }
  |slice| "Archive" { value: 13; }
]
