// Lini's wordmark, drawn call by call with the sketch pen [SPEC 15.3] — three
// closed subpaths for the letters, a `pattern:`ed eyebrow, a `pattern:`ed dot,
// and nothing else. Every edge is an orthogonal run or a circular arc: the
// tangent `arc(r, deg)` continues the heading and sweeps, so a round end is
// 180° at the stroke's half-width and a hook 180° at the swept radius, while
// the two-point `arc(dx, dy, r)` takes the minor arc between endpoints already
// known. Root `layout: drawing` [SPEC 15.1] gives the three pens one shared
// datum, and `density: 1` renders the artwork 1 : 1 — the output is
// assets/logo/lini.svg.
{
  layout: drawing; density: 1; padding: 25;

  // The letterform's numbers, each stated once [SPEC 10.7]: a stroke of
  // half-width `cap` swept along a centreline of radius `bowl` runs `outer`
  // around a hook's outside and `inner` around its inside.
  cap = 9;
  bowl = 25;
  outer = (bowl + cap);
  inner = (bowl - cap);
  // the tall run — cap centre to bowl centre — which the dots also span
  stem = 97;
  dot = (bowl / 3);
  // the bite out of the eyebrow; the dome sweeps the rest of the turn
  notch = 96.379;

  |sketch| { fill: #e9536c; stroke: none; }
}

// `l`, `n`, the `i`'s hooked tail — three closed subpaths, one even-odd fill.
|sketch#glyphs| {
  draw: move(0, cap) down(stem) arc(outer, -180) up(bowl) arc(cap, -180)
        down(bowl) arc(inner, 180) up(stem) arc(cap, -180) close()
        move(154, 131) up(bowl) arc(outer, -180) down(bowl) arc(cap, -180)
        up(bowl) arc(inner, 180) down(bowl) arc(cap, -180) close()
        move(172, 81) down(bowl) arc(outer, -90) arc(cap, -180) arc(inner, 90)
        up(bowl) arc(cap, -180) close();
}

// The eyebrow — the bite, a cap, the dome, a cap — every radius a `cap` scale.
|sketch#brow| {
  draw: move(52.292, 52.5) arc(13.416, 0, cap) arc(cap / 2, -notch)
        arc(cap * 2, notch - 360) arc(cap / 2, -notch) close();
  pattern: grid(2, 1, 122, 0); fill: #9c8cee;
}

|sketch#dot| {
  draw: move(222, cap) down(dot) arc(cap, -180) up(dot) arc(cap, -180) close();
  pattern: grid(1, 3, 0, (stem - dot) / 2); opacity: 0.75;
}
