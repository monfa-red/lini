// A 3.3 V rail — the smallest honest sheet: a linear regulator, its output
// cap, and the header it feeds. `layout: schematic` splits the children by
// role — 3+-pin parts are **anchors** and ride the scope's track row; labels
// and 1–2-pin parts are **satellites**, seated at the pin their wire touches
// and auto-posed to face back up the chain. The wires stay the router's,
// landing on fixed ports: a pin's stub tip, a label's connection point.
{
  layout: schematic;

  // A power flag is a define with intrinsic text [SPEC 8/16.4]: the symbol is
  // drawn with its connection point at the bottom, so a chain ending in one
  // grows **up** out of the pin it feeds.
  |v5::label| { symbol: power; } [
    "5V"
  ]
}

// ── anchors ──
|component#u1| "AMS1117-3.3" [
  |pin#vin| { side: left; number: 3; }
  |pin#gnd| { side: bottom; number: 1; }
  |pin#vout| { side: right; number: 2; }
]
// `pins: 3` generates p1–p3, split bilaterally; `rotate:` is read at lowering
// — the pins re-side (and their rail reverses) while every text stays upright,
// so the header's own pins face back at the regulator.
|J#j1| "3V3 OUT" { pins: 3; rotate: 180; }

// ── satellites ──
|C#c1| "22u"
|gnd#g1|

// ── wires ──
u1.vin - |v5|
// a chain **passes through** the cap: it enters on p1 and leaves by p2, so the
// output rail, the decoupling cap and its ground are one series statement,
// hanging off the wire that leaves `vout`
u1.vout - c1 - g1
// a net name is the wire's own label, placed along the route
u1.vout - j1.p3 "3V3"
// the capsule form — a label declared where it is wired
u1.gnd - |gnd|
// a label wire — the one-ended statement mints the net tag it points at, and
// the op's end marker shapes it (`->` sets `right`, the flag drawn to a point)
j1.p1 -> "NSTDBY"
