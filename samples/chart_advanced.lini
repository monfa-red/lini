// Scales, axes and formulas [SPEC 14.3–14.5] — the domain side of a chart,
// none of it on the hero board: a `scale: log` axis's decade ticks, a time axis
// reading ISO date literals on a calendar `step:`, a `range:` that both crops
// and runs high→low, two value axes sharing one plot (each with its own
// `unit:`, the second declining gridlines so the grid stays single), `format:`
// setting a tick's presentation, a whole-domain `fn:` in `x` that two series
// share through one stylesheet function at 60 `samples:`, and a per-band `fn:`
// list clocked in local `u` across three |band|s.
{
  layout: grid; columns: repeat(2); gap: 24;
  cure(k) = (100 * (1 - exp(-x/k)));
}

|chart| "Requests by tier (req/s)" {
  width: 350; height: 240; categories: "free", "pro", "team", "ent";
} [
  |axis| { side: left; scale: log; }
  |bars| { data: 5, 80, 1200, 45000; }
]

// Date literals make the x axis a time axis; `step: month` lands the ticks on
// calendar boundaries rather than on even spacings of the epoch.
|chart| "Weekly active users" { width: 350; height: 240; } [
  |axis| { side: bottom; step: month; }
  |axis| "users" { side: left; unit: "k"; }
  |line| "wau" {
    data: "2026-01-05" 12, "2026-02-02" 15, "2026-03-02" 21, "2026-04-06" 28, "2026-05-04" 34, "2026-06-01" 45; marker: dot;
  }
]

// `range: 50 1` does both of its jobs at once: 1 is the top of the chart, so
// the axis runs high→low, and the album's opening week at 62 falls outside the
// window and is cropped to the plot.
|chart| "Chart position" {
  width: 350; height: 240; categories: "Jan", "Feb", "Mar", "Apr", "May", "Jun";
} [
  |axis| "position" { side: left; range: 50 1; }
  |line| "single" { data: 44, 31, 18, 9, 12, 4; marker: circle; }
  |line| "album" { data: 62, 48, 35, 22, 16, 11; marker: circle; }
]

|chart| "Throughput vs. error rate" {
  width: 350; height: 240; categories: "Mon", "Tue", "Wed", "Thu", "Fri";
} [
  |axis#req| "requests" { side: left; unit: "/s"; }
  |axis#err| "errors" {
    side: right; range: 0 3; unit: "%"; format: decimal 1; gridlines: none;
  }
  |bars| "requests" { data: 820, 932, 901, 1090, 1204; axis: req; }
  |line| "error rate" { data: 2.1, 0.8, 1.5, 0.4, 0.6; axis: err; marker: dot; }
]

// One `cure(k)` binding, two adhesives: the same closed form sampled twice at
// its own time constant, so the pair can never drift apart.
|chart| "Cure strength" { width: 350; height: 240; samples: 60; } [
  |axis| "minutes" { side: bottom; range: 0 90; }
  |axis| { side: left; range: 0 100; unit: "%"; }
  |line| "epoxy" { fn: (cure(18)); }
  |line| "acrylic" { fn: (cure(34)); stroke-style: dashed; }
]

// Bands cut the domain into three segments and the series answers with a
// per-band `fn:` list — one expression each, clocked `0 → 1` in local `u`,
// the risers between them drawn because the jump is real.
|chart| "Motor draw (A)" { width: 350; height: 240; } [
  |axis| "phase" { side: bottom; }
  |axis| { side: left; }
  |band| "Close" { range: 0 1.4; fill: --sky; }
  |band| "Inject" { range: 1.4 3.1; fill: --rose; }
  |band| "Hold" { range: 3.1 5.1; fill: --amber; }
  |line| "draw" {
    stroke: --rose-deep; fn: (0.12 + 1.2*exp(-((u-0.8)/0.12)^2)), (1.5 + 3.0*u^1.1), 0.5;
  }
]
